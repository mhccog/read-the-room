 "playbooks": {
  "rapport": {
   "topic": "openers",
   "title": "Build rapport fast (Talk playbook)",
   "try": "Eyebrow-flash and warmly greet everyone you meet today, then count who flashes back."
  },
  "calm": {
   "topic": "tough",
   "title": "Calm someone down (Talk playbook)",
   "try": "Next time someone is upset, say one true thing they can't disagree with, then pause."
  }
 },
 "playbook_merge": {
  "H25": "objection"
 },
 "overrides": {
  "H11": {
   "move": "Reflect what their day probably felt like (\"You must be shattered\") purely to show you understand them."
  },
  "H13": {
   "move": "Share something real of your own first, at the depth you'd be happy for them to match, so it's easier for them to open up."
  },
  "H14": {
   "move": "When you genuinely don't know, show real interest in their expertise and let them teach you."
  },
  "V68": {
   "move": "Notice brief flashes of the seven universal expressions and respond kindly to the feeling you see.",
   "watch": "A face only tells you a feeling. Respond to it; never treat it as proof of anything."
  },
  "H41": {
   "watch": "A change usually means stress or discomfort. Ask gently; never jump to a conclusion."
  },
  "H15": {
   "watch": "Never say \"you're a significance person\". The needs are hunches to test by listening, never labels."
  },
  "H18": {
   "watch": "Speak in their terms to be understood, never to steer a pitch."
  },
  "H17": {
   "watch": "Only ever give the honest reason. If it isn't true, don't say it."
  },
  "n-ch-about": {
   "mv": "A former US Navy behaviour trainer who teaches body language, composure and people skills through The Behavior Ops Manual (2023) and NCI University.",
   "tr": "Tap the Chase Hughes filter above to study his cards on their own."
  }
 },
